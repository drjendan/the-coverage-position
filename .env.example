PORT=3000
# Local development only. Server binds to 127.0.0.1.
DATA_DIR=./data

# Hosted Netlify mode (npm start remains a separate synthetic SQLite development server).
# Set secure values in Netlify environment settings, never commit credentials.
APP_MODE=preview
# APP_MODE=secure
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# APP_ORIGIN=https://YOUR_SITE.netlify.app
